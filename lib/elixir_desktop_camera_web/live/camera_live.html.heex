<div class="">
  <video
    id="local-video"
    playsinline
    autoplay
    muted
    width="400"
  ></video>
  <button
    id="shutter"
    class="border rounded p-2 bg-blue-500 text-white"
    phx-hook="TakePicture"
  >Take a pickture</button>
  <canvas id="canvas" style="display: none"></canvas>
  <canvas id="canvas-gray"></canvas>
</div>
